{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/simulation/static/index.html" },
    { "source": "/index.html", "destination": "/simulation/static/index.html" },
    { "source": "/styles.css", "destination": "/simulation/static/styles.css" },
    { "source": "/app.js", "destination": "/simulation/static/app.js" },
    { "source": "/store.js", "destination": "/simulation/static/store.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    }
  ]
}
